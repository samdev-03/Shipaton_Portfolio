# Copy to .env. Never commit secrets. Node 24 required.
NODE_ENV=development
PORT=8787
DB_PATH=./data/portfolio.sqlite
PUBLIC_ORIGIN=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
# For each secret independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=
WEBHOOK_SECRET=
OPS_TOKEN=
# Enable only behind a trusted proxy which overwrites X-Forwarded-For.
TRUST_PROXY=0
APP_VARIANT=rehearsal
BUNDLE_ROOT=
EXPO_PUBLIC_API_URL=http://localhost:8787
OPERATOR_NAME=
SUPPORT_EMAIL=
LEGAL_ORIGIN=
# Declare the actual deployed region and verified backup policy.
HOSTING_REGION=
# Use a factual provider-managed policy when no maximum expiry is guaranteed.
BACKUP_RETENTION_POLICY=
# Alternative: a maximum retention period only when expiry is implemented.
BACKUP_RETENTION_DAYS=
PORTFOLIO_PREVIEW=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Native keys and SDK App IDs below are public; RC_SECRET and REST keys are server-only.
REHEARSAL_EAS_PROJECT_ID=
REHEARSAL_RC_IOS_PUBLIC_KEY=
REHEARSAL_RC_ANDROID_PUBLIC_KEY=
REHEARSAL_RC_SECRET_KEY=
REHEARSAL_RC_APP_IDS=
REHEARSAL_ONESIGNAL_APP_ID=
REHEARSAL_ONESIGNAL_REST_KEY=
REHEARSAL_LAYERS_APP_ID=
REHEARSAL_FUNNEL_URL=
CARE_EAS_PROJECT_ID=
CARE_RC_IOS_PUBLIC_KEY=
CARE_RC_ANDROID_PUBLIC_KEY=
CARE_RC_SECRET_KEY=
CARE_RC_APP_IDS=
CARE_ONESIGNAL_APP_ID=
CARE_ONESIGNAL_REST_KEY=
CARE_LAYERS_APP_ID=
CARE_FUNNEL_URL=
MEAL_EAS_PROJECT_ID=
MEAL_RC_IOS_PUBLIC_KEY=
MEAL_RC_ANDROID_PUBLIC_KEY=
MEAL_RC_SECRET_KEY=
MEAL_RC_APP_IDS=
MEAL_ONESIGNAL_APP_ID=
MEAL_ONESIGNAL_REST_KEY=
MEAL_LAYERS_APP_ID=
MEAL_FUNNEL_URL=
QUOTE_EAS_PROJECT_ID=
QUOTE_RC_IOS_PUBLIC_KEY=
QUOTE_RC_ANDROID_PUBLIC_KEY=
QUOTE_RC_SECRET_KEY=
QUOTE_RC_APP_IDS=
QUOTE_ONESIGNAL_APP_ID=
QUOTE_ONESIGNAL_REST_KEY=
QUOTE_LAYERS_APP_ID=
QUOTE_FUNNEL_URL=
